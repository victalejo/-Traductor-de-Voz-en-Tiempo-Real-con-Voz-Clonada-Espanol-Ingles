# Renombrá este archivo a `.env` y completá tu clave real de ElevenLabs.

ELEVENLABS_API_KEY=your_api_key_here

# Opcionales
# ID de la voz de ElevenLabs (por defecto: Rachel)
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Tamaño del modelo Whisper: tiny | base | small | medium | large-v2 | large-v3
# WHISPER_MODEL=base

# Dispositivo: auto | cpu | cuda
# WHISPER_DEVICE=auto

# Tipo de cómputo: int8 (CPU rápido) | float16 (GPU) | float32
# WHISPER_COMPUTE_TYPE=int8
